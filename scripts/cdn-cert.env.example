# CDN certificate management variables
# These belong in .env alongside the other project variables, not in a separate file.
# This file is kept as a reference for what variables are required.

# CF_API_TOKEN is reused for the Cloudflare DNS challenge (no separate token needed)

# DigitalOcean personal access token — needs read+write scope
# Create at https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=

# DigitalOcean CDN endpoint ID — find it by running:
#   curl -s -H "Authorization: Bearer $DO_API_TOKEN" \
#        https://api.digitalocean.com/v2/cdn/endpoints | jq '.endpoints[] | {id, origin, custom_domain}'
DO_CDN_ENDPOINT_ID=

# Custom domain to configure on the CDN
CDN_DOMAIN=cdn.example.com

# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=example@example.com

# Set to true to use the Let's Encrypt staging server (issues untrusted test certs).
# Use when testing from a dev environment — same DNS challenge process, no rate limits.
CERTBOT_STAGING=false
